# Copy to .env (git-ignored); the training, generation and evaluation entry
# points load it automatically. Every variable is optional.

# Rendered training layout (built from the HF dataset by scripts/reproduce.py
# or robotalk.release.materialize_training_layout). Default: data/robotalk_rendered
# ROBOTALK_DATA_ROOT=data/robotalk_rendered

# Where runs, evaluations and figures are written. Default: outputs
# ROBOTALK_OUTPUT_ROOT=outputs

# Hugging Face cache for base models, adapters and the dataset.
# HF_HOME=~/.cache/huggingface

# Command prefix used to start vLLM, e.g. to run it inside a container:
# VLLM_LAUNCHER="apptainer exec --nv vllm-openai-v0.27.1.sif"

# Gemini (trajectory generation and the Fig. 5 Gemini cells). Either an API key
# for the Gemini Developer API ...
# GOOGLE_API_KEY=
# ... or Vertex AI with application-default credentials
# (gcloud auth application-default login):
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# Weights & Biases project for training runs (reproduce.py disables wandb by default).
# WANDB_PROJECT=robotalk
